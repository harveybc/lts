[Unit]
Description=LTS MT5 Demo ETH model execution runner
After=network-online.target lts-mt5-execution-bridge.service
Wants=network-online.target
Requires=lts-mt5-execution-bridge.service

[Service]
Type=simple
WorkingDirectory=%h/Documents/GitHub/lts
ExecStart=%h/anaconda3/envs/trading-stack/bin/python -m app.mt5_model_runner --config examples/configs/mt5_eth_model_runner_v1.json
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/lts

[Install]
WantedBy=default.target
