[Unit]
Description=LTS MT5 bridge deterministic watchdog
After=lts-mt5-bridge.service
Wants=lts-mt5-bridge.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/GitHub/lts
ExecStart=%h/anaconda3/envs/trading-stack/bin/python tools/paper_execution_watchdog.py --mt5-only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/lts

