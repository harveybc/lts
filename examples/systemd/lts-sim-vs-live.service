[Unit]
Description=LTS same-window sim-vs-Paper/Demo comparison rows + rolling report (WO2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/GitHub/lts
ExecStart=%h/anaconda3/envs/trading-stack/bin/python %h/Documents/GitHub/lts/tools/sim_vs_live_window.py collect --config %h/.config/lts/sim-vs-live.json
ExecStartPost=%h/anaconda3/envs/trading-stack/bin/python %h/Documents/GitHub/lts/tools/sim_vs_live_window.py report --config %h/.config/lts/sim-vs-live.json --output %h/.local/state/lts/sim-vs-live/reports/rolling_latest.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/lts

[Install]
WantedBy=default.target
